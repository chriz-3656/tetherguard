steps:
  - name: 'ubuntu'
    args: ['chmod', '+x', './gradlew']
  - name: 'ghcr.io/cirruslabs/android-sdk:34'
    entrypoint: 'bash'
    args: ['-c', './gradlew assembleDebug']
artifacts:
  objects:
    location: 'gs://${PROJECT_ID}_build_artifacts/'
    paths:
      - 'app/build/outputs/apk/debug/*.apk'